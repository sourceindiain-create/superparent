# GEMINI_API_KEY: Required for Gemini AI Multi-Expert API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# RAZORPAY CONFIGURATION (Live Payment Gateway & Webhooks)
# Required for live payment processing and checkout flow
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ADMIN AUTHENTICATION (Protected Backend Access)
ADMIN_ID=admin
ADMIN_PASSWORD=

# SYSTEM SECURITY & DEMO FLAGS
# In production, set both to false to enforce live Razorpay payment & strict auth
DEMO_MODE=false
SYSTEM_MASTER_ACCESS=false

# APP_URL: The URL where this applet is hosted.
APP_URL=
